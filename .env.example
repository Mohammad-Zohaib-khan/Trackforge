# TrackForge environment template. Copy to `.env` (repo root or apps/api/.env).
# Never commit a real .env. All values below are placeholders.

# development | test | production
NODE_ENV=development
PORT=4000

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/trackforge
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trackforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trackforge

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# Connection pool size (default 20).
MONGODB_MAX_POOL_SIZE=20

# Browser origins allowed to call the API (comma-separated, exact match, HTTPS in production).
APP_ORIGINS=http://localhost:5173

# Session lifetime: idle timeout (minutes, renewed on activity) and absolute limit (hours).
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=168
SESSION_COOKIE_NAME=tf.sid
# native = MongoDB TTL index (recommended). interval = periodic cleanup for servers without TTL support.
SESSION_STORE_AUTOREMOVE=native

# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku/Nginx). 0 when none.
TRUST_PROXY=0

# Optional: serve the built web app from the API (same origin). Path to apps/web/dist.
# SERVE_WEB_DIST=../web/dist

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limits per 15-minute window.
AUTH_RATE_LIMIT_MAX=20
LOGIN_FAILURES_PER_EMAIL_MAX=5
EXPORT_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=600

# Seed script (npm run seed). Local/demo use only.
# SEED_DEMO_PASSWORD=choose-a-demo-password-1

# Web app (Vite). Leave unset when the API is served from the same origin or via the dev proxy.
# VITE_API_URL=https://api.example.com
